              <calculation class='tableau' formula='COUNTD(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [churn_date]) = #2025-12-01#&#13;&#10;        THEN [customer_id (customer_churn.csv)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;    COUNTD(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [billing_month]) = #2025-12-01#&#13;&#10;        THEN [customer_id (monthly_billing.csv)]&#13;&#10;        END&#13;&#10;    )' />
            </column>
            <column caption='Billing Month' datatype='date' name='[billing_month]' role='dimension' type='ordinal' />
