      <column caption='Ticket Count' datatype='integer' name='[Calculation_1757894350229507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id (support_tickets.csv)] : COUNTD([ticket_id]) }' />
      </column>
      <column caption='Ticket Volume Group' datatype='string' name='[Calculation_1757894368256004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1757894350229507] = 0 THEN &quot;No tickets&quot;&#13;&#10;ELSEIF [Calculation_1757894350229507] = 1 THEN &quot;1 ticket&quot;&#13;&#10;ELSEIF [Calculation_1757894350229507] &lt;= 3 THEN &quot;2–3 tickets&quot;&#13;&#10;ELSE &quot;4+ tickets&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Customer Usage' datatype='real' name='[Calculation_1757894370643973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id (monthly_usage.csv)] : AVG([data_usage_gb]) }' />
      </column>
      <column caption='Usage Group' datatype='string' name='[Calculation_1757894370996230]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1757894370643973] &lt; 250 THEN &quot;Under 250 GB&quot;&#13;&#10;ELSEIF [Calculation_1757894370643973] &lt; 500 THEN &quot;250–500 GB&quot;&#13;&#10;ELSEIF [Calculation_1757894370643973] &lt; 750 THEN &quot;500–750 GB&quot;&#13;&#10;ELSE &quot;750+ GB&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Churn by Usage' datatype='integer' name='[Calculation_1757894380003340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id (monthly_usage.csv)], [Calculation_1757894370996230] : MAX([churned])}' />
      </column>
      <column caption='Net Customer Growth' datatype='integer' name='[Calculation_1757894411878413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF DATETRUNC(&apos;month&apos;, [acquisition_date]) = #2025-12-01#&#13;&#10;    THEN [customer_id (acquisitions.csv)]&#13;&#10;    END&#13;&#10;)&#13;&#10;-&#13;&#10;COUNTD(&#13;&#10;    IF DATETRUNC(&apos;month&apos;, [churn_date]) = #2025-12-01#&#13;&#10;    THEN [customer_id (customer_churn.csv)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_1757894415392782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [churn_date]) = #2025-12-01#&#13;&#10;        THEN [customer_id (customer_churn.csv)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;    COUNTD(&#13;&#10;        IF DATETRUNC(&apos;month&apos;, [billing_month]) = #2025-12-01#&#13;&#10;        THEN [customer_id (monthly_billing.csv)]&#13;&#10;        END&#13;&#10;    )' />
      </column>
