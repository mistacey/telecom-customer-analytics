              <calculation class='tableau' formula='IF [Calculation_1757894370643973] &lt; 250 THEN &quot;Under 250 GB&quot;&#13;&#10;ELSEIF [Calculation_1757894370643973] &lt; 500 THEN &quot;250–500 GB&quot;&#13;&#10;ELSEIF [Calculation_1757894370643973] &lt; 750 THEN &quot;500–750 GB&quot;&#13;&#10;ELSE &quot;750+ GB&quot;&#13;&#10;END' />
